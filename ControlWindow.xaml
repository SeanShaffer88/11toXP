<Window x:Class="LunaDesktop.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="11toXP" Width="568" Height="690" MinWidth="540" MinHeight="480"
        FontFamily="Tahoma" FontSize="13" Foreground="{DynamicResource Ink}"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Panel}" AutomationProperties.AutomationId="LunaControl"
        Closing="OnClosing" Closed="OnClosed">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="Ink" Color="#172839"/>
    <SolidColorBrush x:Key="Rule" Color="#ACA899"/>
    <SolidColorBrush x:Key="StatusPanel" Color="#FAF9F1"/>
    <SolidColorBrush x:Key="CaptionInk" Color="White"/>
    <SolidColorBrush x:Key="Frame" Color="#07378B"/>
    <LinearGradientBrush x:Key="TitleFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#4399FF"/>
      <GradientStop Offset="0.55" Color="#0B5CE7"/>
      <GradientStop Offset="1" Color="#0646BD"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#FFFFFF"/>
      <GradientStop Offset="1" Color="#E5EBF2"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonEdge" Color="#2455A0"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#D6E7FF"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#BACFE7"/>
    <SolidColorBrush x:Key="CaptionClose" Color="#C83B22"/>
    <SolidColorBrush x:Key="DisabledInk" Color="#64717F"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource ButtonFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBox" CornerRadius="3" BorderThickness="1"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBox" Property="Background" Value="{DynamicResource ButtonHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBox" Property="Background" Value="{DynamicResource ButtonPressed}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBox" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="33" ResizeBorderThickness="5" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Frame}" BorderThickness="3">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="33"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Background="{DynamicResource TitleFill}">
        <TextBlock Text="11toXP" Foreground="{DynamicResource CaptionInk}" FontSize="16"
                   FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,4,4">
          <Button Content="−" AutomationProperties.Name="Minimize" MinHeight="0" Width="26"
                  Padding="0" Margin="0,0,3,0" Click="MinimizeClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Content="×" AutomationProperties.Name="Close" MinHeight="0" Width="26"
                  Padding="0" FontWeight="Bold" Foreground="{DynamicResource CaptionInk}"
                  Background="{DynamicResource CaptionClose}" Click="CloseClick"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,17,22,18" KeyboardNavigation.TabNavigation="Continue">
          <TextBlock Text="Windows XP Appearance" FontSize="23" FontWeight="Bold"/>
          <UniformGrid Columns="3" Margin="0,12,0,12">
            <RadioButton x:Name="BlueVariant" Content="Luna Blue" GroupName="LunaVariant"
                         MinHeight="28" AutomationProperties.AutomationId="LunaBlue" Checked="VariantChanged"/>
            <RadioButton x:Name="SilverVariant" Content="Luna Silver" GroupName="LunaVariant"
                         MinHeight="28" AutomationProperties.AutomationId="LunaSilver" Checked="VariantChanged"/>
            <RadioButton x:Name="OliveVariant" Content="Luna Olive Green" GroupName="LunaVariant"
                         MinHeight="28" AutomationProperties.AutomationId="LunaOliveGreen" Checked="VariantChanged"/>
          </UniformGrid>
          <UniformGrid x:Name="Components" Columns="2" Margin="0,0,0,8">
            <CheckBox x:Name="UseXpTaskbar" Content="Taskbar and Start Menu" MinHeight="26"
                      AutomationProperties.AutomationId="UseXpTaskbar"/>
            <CheckBox x:Name="UseDesktopIcons" Content="Desktop Icons" MinHeight="26"
                      AutomationProperties.AutomationId="UseDesktopIcons"/>
            <CheckBox x:Name="UseCursors" Content="Cursors" MinHeight="26"
                      AutomationProperties.AutomationId="UseCursors"/>
            <CheckBox x:Name="UseSounds" Content="Sounds" MinHeight="26"
                      AutomationProperties.AutomationId="UseSounds"/>
            <CheckBox x:Name="WallpaperOptIn" Content="Change Wallpaper" MinHeight="26"
                      AutomationProperties.AutomationId="ChangeWallpaper"
                      Checked="WallpaperChoiceChanged" Unchecked="WallpaperChoiceChanged"/>
            <CheckBox x:Name="UseXpExplorer" Content="Use XP Explorer" MinHeight="26"
                      ToolTip="Open folders from the XP taskbar and Start menu in XP Explorer."
                      AutomationProperties.AutomationId="UseXpExplorer"/>
          </UniformGrid>
          <DockPanel Margin="0,2,0,12" LastChildFill="True">
            <Button x:Name="WallpaperPicker" DockPanel.Dock="Right" Content="Choose Image…"
                    IsEnabled="False" AutomationProperties.AutomationId="ChooseWallpaper" Click="BrowseClick"/>
            <TextBlock x:Name="WallpaperFile" Text="Keep my current wallpaper."
                       VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Border Height="1" Background="{DynamicResource Rule}" Margin="0,0,0,13"/>
          <StackPanel x:Name="TaskbarSettings" Margin="0,0,0,12">
            <TextBlock Text="Taskbar" FontSize="16" FontWeight="Bold"/>
            <DockPanel Margin="0,6,0,8">
              <Label Content="Group Similar Windows" Target="{Binding ElementName=GroupingChoice}"
                     Padding="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
              <ComboBox x:Name="GroupingChoice" MinWidth="142" MinHeight="28" HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="TaskGrouping" AutomationProperties.Name="Group Similar Windows">
                <ComboBoxItem Content="Never" AutomationProperties.AutomationId="TaskGroupingNever"/>
                <ComboBoxItem Content="Always" AutomationProperties.AutomationId="TaskGroupingAlways"/>
              </ComboBox>
            </DockPanel>
            <TextBlock Text="Quick Launch" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="228"/>
              </Grid.ColumnDefinitions>
              <ListBox x:Name="LaunchList" MinHeight="82" Margin="0,0,10,0"
                       DisplayMemberPath="Label" SelectionChanged="QuickLaunchSelectionChanged"
                       AutomationProperties.Name="Quick Launch Items" AutomationProperties.AutomationId="QuickLaunchItems"/>
              <StackPanel Grid.Column="1">
                <DockPanel Margin="0,0,0,4">
                  <Button x:Name="AddShortcut" DockPanel.Dock="Right" Content="Add" Margin="5,0,0,0"
                          AutomationProperties.AutomationId="QuickLaunchAdd" Click="QuickLaunchAddClick"/>
                  <ComboBox x:Name="AvailableShortcuts" DisplayMemberPath="Label" VerticalContentAlignment="Center"
                            AutomationProperties.Name="Available Quick Launch Items"
                            AutomationProperties.AutomationId="QuickLaunchAvailable"/>
                </DockPanel>
                <UniformGrid Columns="3">
                  <Button x:Name="RemoveShortcut" Content="Remove" Padding="4,3" Margin="0,0,4,0"
                          AutomationProperties.AutomationId="QuickLaunchRemove" Click="QuickLaunchRemoveClick"/>
                  <Button x:Name="MoveShortcutUp" Content="Move Up" Padding="4,3" Margin="0,0,4,0"
                          AutomationProperties.AutomationId="QuickLaunchUp" Click="QuickLaunchUpClick"/>
                  <Button x:Name="MoveShortcutDown" Content="Move Down" Padding="4,3"
                          AutomationProperties.AutomationId="QuickLaunchDown" Click="QuickLaunchDownClick"/>
                </UniformGrid>
              </StackPanel>
            </Grid>
          </StackPanel>
          <WrapPanel Margin="0,0,0,12">
            <Button Content="Open XP Explorer" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="OpenXpExplorer" Click="OpenXpExplorerClick"/>
            <Button x:Name="FocusTaskbarAction" Content="_Focus XP Taskbar"
                    AutomationProperties.AutomationId="FocusXpTaskbar" Click="FocusTaskbarClick"/>
          </WrapPanel>
          <Border Padding="10,8" Background="{DynamicResource StatusPanel}" BorderBrush="{DynamicResource Rule}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Taskbar" FontWeight="Bold" Margin="0,0,0,4"/>
              <TextBlock Grid.Column="1" x:Name="ShellValue" Margin="0,0,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Text="Appearance" FontWeight="Bold" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AppearanceValue" Margin="0,0,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Text="Wallpaper" FontWeight="Bold" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="WallpaperValue" Margin="0,0,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Text="Sign-in" FontWeight="Bold" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StartupValue" Margin="0,0,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="4" Text="Compatibility" FontWeight="Bold"/>
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CompatibilityValue" TextWrapping="Wrap"/>
            </Grid>
          </Border>
          <TextBlock x:Name="StatusMessage" Margin="0,11,0,0" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="ThemeStatus" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="22,0,22,15">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1.6*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ApplyAction" Content="_Apply" Margin="0,0,5,0"
                AutomationProperties.AutomationId="ApplyButton" Click="ApplyClick"/>
        <Button Grid.Column="1" x:Name="RepairAction" Content="_Repair" Margin="0,0,5,0"
                AutomationProperties.AutomationId="RepairButton" Click="RepairClick"/>
        <Button Grid.Column="2" x:Name="RestoreAction" Content="Res_tore" Margin="0,0,5,0"
                AutomationProperties.AutomationId="RestoreButton" Click="RestoreClick"/>
        <Button Grid.Column="3" x:Name="RestoreAndExitAction" Content="Restore and E_xit"
                AutomationProperties.AutomationId="RestoreAndExitButton" Click="RestoreAndExitClick"/>
      </Grid>
    </Grid>
  </Border>
</Window>
