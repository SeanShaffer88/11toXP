<Window x:Class="LunaDesktop.Browser.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal" Title="11toXP File Browser" Width="910" Height="560"
        MinWidth="740" MinHeight="400" WindowStartupLocation="CenterScreen" WindowStyle="None"
        FontFamily="Tahoma" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="FileBrowser" PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="29" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <DataTemplate x:Key="FileNameTemplate">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="FolderGlyph" Width="15" Height="13" Stretch="Fill" Margin="0,0,6,0"
                      Fill="{DynamicResource FolderGlyphFill}" Stroke="{DynamicResource FolderGlyphStroke}"
                      Data="M1,3 L6,3 8,5 14,5 14,12 1,12 Z" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Directory}" Value="False">
                    <Setter TargetName="FolderGlyph" Property="Data" Value="M3,1 L9,1 12,4 12,12 3,12 Z M9,1 L9,4 12,4" />
                    <Setter TargetName="FolderGlyph" Property="Fill" Value="{DynamicResource FileGlyphFill}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Border BorderThickness="2" BorderBrush="{DynamicResource FrameBrush}"
            Background="{DynamicResource SurfaceBrush}" TextElement.Foreground="{DynamicResource SurfaceText}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="29" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Background="{DynamicResource CaptionBrush}" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,3,0">
                    <Button Content="−" Click="MinimizeClick" AutomationProperties.Name="Minimize" Style="{StaticResource CaptionButton}" />
                    <Button Content="□" Click="MaximizeClick" AutomationProperties.Name="Maximize or Restore" Style="{StaticResource CaptionButton}" />
                    <Button Content="×" Click="CloseClick" AutomationProperties.Name="Close" Style="{StaticResource CaptionButton}" />
                </StackPanel>
                <TextBlock Text="11toXP File Browser" Foreground="{DynamicResource CaptionText}" VerticalAlignment="Center"
                           FontWeight="Bold" Margin="8,0,0,0" />
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackAction" Content="‹  Back" Click="BackClick" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Back" AutomationProperties.AutomationId="BrowserBack" />
                    <Button x:Name="ForwardAction" Content="Forward  ›" Click="ForwardClick" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Forward" AutomationProperties.AutomationId="BrowserForward" />
                    <Button x:Name="UpAction" Content="↑  Up" Click="UpClick" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Up" AutomationProperties.AutomationId="BrowserUp" />
                    <Button x:Name="RefreshAction" Content="Refresh" Click="RefreshClick" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.AutomationId="BrowserRefresh" />
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="2" Margin="6,4" LastChildFill="True">
                <Label Target="{Binding ElementName=Address}" DockPanel.Dock="Left" Content="_Address" Padding="2,4,9,4" />
                <Button DockPanel.Dock="Right" Content="_Go" Click="AddressClick" Margin="5,0,0,0" MinWidth="42"
                        AutomationProperties.AutomationId="BrowserGo" />
                <TextBox x:Name="Address" KeyDown="AddressKeyDown" Padding="3" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="BrowserAddress" AutomationProperties.Name="Folder Address" />
            </DockPanel>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172" />
                    <ColumnDefinition Width="166" MinWidth="130" MaxWidth="345" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SidebarBrush}" Padding="6">
                    <StackPanel>
                        <StackPanel Background="{DynamicResource TaskCardBrush}">
                            <Border Background="{DynamicResource CaptionBrush}" Padding="5,5">
                                <TextBlock Text="File and Folder Tasks" Foreground="{DynamicResource CaptionText}" FontWeight="Bold" />
                            </Border>
                            <Button x:Name="NativeExplorer" Click="NativeExplorerClick" Margin="5" Padding="5,4" MinHeight="26"
                                    ToolTip="Open the folder shown in the details pane."
                                    AutomationProperties.Name="Open in Windows Explorer" AutomationProperties.AutomationId="BrowserOpenNative">
                                <TextBlock Text="Open in Windows Explorer" TextWrapping="Wrap" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="PlacesCard" Background="{DynamicResource TaskCardBrush}" Margin="0,7,0,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource CaptionBrush}" Padding="5,5">
                                <TextBlock Text="Other Places" Foreground="{DynamicResource CaptionText}" FontWeight="Bold" />
                            </Border>
                            <ItemsControl x:Name="Places" Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Tag="{Binding Path}" Click="PlaceClick" MinHeight="25"
                                                HorizontalContentAlignment="Left" Margin="0,0,0,3" Padding="5,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DockPanel Grid.Column="1" Background="{DynamicResource TaskCardBrush}" LastChildFill="True">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                        <TextBlock Text="Folders" FontWeight="Bold" />
                    </Border>
                    <TreeView x:Name="Folders" Margin="3" SelectedItemChanged="FolderSelected"
                              AutomationProperties.AutomationId="BrowserFolderTree" AutomationProperties.Name="Folders"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                </DockPanel>
                <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource DividerBrush}" AutomationProperties.Name="Resize Folders Pane" />
                <ListView x:Name="Details" Grid.Column="3" BorderThickness="1" MouseDoubleClick="DetailsDoubleClick" KeyDown="DetailsKeyDown"
                          AutomationProperties.AutomationId="BrowserDetails" AutomationProperties.Name="Folder Contents"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" SelectionMode="Single">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Name" Width="168" CellTemplate="{StaticResource FileNameTemplate}" />
                            <GridViewColumn Header="Size" Width="60" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="Type" Width="78" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="Date Modified" Width="136" DisplayMemberBinding="{Binding ModifiedText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
            <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="7,5">
                <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.AutomationId="BrowserStatus"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Border>
</Window>
